# Copy to .env and fill in. .env is git-ignored — never commit real tokens.
#
# Get a long-lived Claude Code OAuth token (subscription login) per account:
#   claude setup-token
#
# One token is required; add more (from separate accounts) and the harness
# uses them round-robin, rotating to the next key when one hits its rate
# limit. Any env var starting with CLAUDE_CODE_OAUTH_TOKEN is picked up.
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CODE_OAUTH_TOKEN_2=
# CLAUDE_CODE_OAUTH_TOKEN_3=

# For OpenRouter-routed models (config model like "openai/gpt-5.5"); same
# round-robin scheme (OPENROUTER_API_KEY, _2, _3, ...).
# OPENROUTER_API_KEY=

# For the local Codex-subscription LiteLLM pool. Add/start the sidecars as
# documented in docs/codex-subscription-via-litellm.md, then copy the output of
# `./scripts/codex_pool.sh env N` here. Use model `litellm/gpt-5.5`.
# LITELLM_API_KEY=sk-codex-local-only
# LITELLM_BASE_URL=http://olympiad-codex-litellm-1:4000
# LITELLM_BASE_URL_2=http://olympiad-codex-litellm-2:4000
